vs_asset_forge/.vs/
vs_asset_forge/bin/
vs_asset_forge/obj/
vs_asset_forge/x64/
vs_asset_forge/Release/
vs_asset_forge/Debug/
*.exe
*.dll
*.pdb
*.ilk
*.tlog
*.log
*.user
*.suo

# Godot cache & temporary runtime files
godot_project/.godot/
godot_project/.import/
